# Copy to .env and chmod 600:
#   cp -n dotenv.sample .env && chmod 600 .env
#
# HOST_ROLE selects which Pi this checkout is:
#   pi4 — Victron BLE, Mosquitto, Home Assistant (default)
#   pi5 — house AdGuard DNS + Theengs BLE gateway to the Pi 4 broker
# If unset, deploy.sh uses pi5 when the LAN IP is 192.168.0.240, otherwise pi4.
# HOST_ROLE=pi4

# MQTT broker settings for Mosquitto, Home Assistant, and victron_ble2mqtt.
# Prefer the Pi LAN IP (hostname -I) over localhost for reliable host-network clients.
# On HOST_ROLE=pi5 this MUST be the Pi 4 address (e.g. 192.168.0.223), not this Pi.

MQTT_HOST=192.168.0.XX
MQTT_PORT=1883
MQTT_USER=victron
MQTT_PASSWORD=your_secure_password_here

# Optional: pin / override Home Assistant image (default set in docker-compose.homeassistant.yml)
# HA_IMAGE=ghcr.io/home-assistant/home-assistant:2026.7.3

# Optional BLE adapter (bluetoothctl list). Default is BlueZ default (usually hci0).
# BLE_ADAPTER=hci0

# Timezone for Home Assistant
TZ=America/Chicago

# Wi-Fi failover (optional)
# WIFI_SSID=
# WIFI_PASSWORD=

# ADVKEY_* device advertisement keys: prefer ./victron-secrets.env (chmod 600).
# If the same variable is set in both files, .env wins (see scripts/redeploy_victron.sh).

# Device on/off — see docs/DEVICES.md
# ENABLE_HOME_ASSISTANT=1
# --- Sungold SPH302480A (optional read-only Modbus sidecar) ---
# ENABLE_SUNGOLD=0
# SUNGOLD_SERIAL_DEVICE=/dev/sungold
# MODBUS_ADDRESS=1
# MODBUS_BAUDRATE=9600
# MQTT_TOPIC=sungold_sph302480a
# DEVICE_NAME=Sungold SPH302480A
# POLL_INTERVAL_SEC=5
